{
  "manifest_version": 3,
  "name": "vRO Code Editor Resizer",
  "version": "2.1.1",
  "description": "Adds a button to resize the vRO (VCF Orchestrator) code editor for better visibility.",
  "content_scripts": [
    {
      "matches": [
        "*://*/orchestration-ui",
        "*://*/orchestration-ui/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
